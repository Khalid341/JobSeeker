@{
    Layout = "_Layout";
}

<div class="row">
    <div class="col-lg-3 mb-4">
        <div class="card shadow-sm border-0 sidebar-menu">
            <div class="card-body p-3">
                <h5 class="card-title mb-3"><i class="bi bi-building me-2 text-primary"></i>لوحة صاحب العمل</h5>
                <div class="list-group list-group-flush">
                    <a asp-controller="Employer" asp-action="Dashboard" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i>لوحة التحكم
                    </a>
                    <a asp-controller="Employer" asp-action="Profile" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Profile" ? "active" : "")">
                        <i class="bi bi-building me-2"></i>الملف الشخصي
                    </a>
                    <a asp-controller="Employer" asp-action="EditCompany" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "EditCompany" ? "active" : "")">
                        <i class="bi bi-pencil-square me-2"></i>تعديل بيانات الشركة
                    </a>
                    <a asp-controller="Employer" asp-action="SearchCandidates" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "SearchCandidates" ? "active" : "")">
                        <i class="bi bi-search me-2"></i>البحث عن المرشحين
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-9">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}

@section Styles {
    @await RenderSectionAsync("Styles", required: false)
}
