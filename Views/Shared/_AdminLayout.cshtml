@{
    Layout = "_Layout";
}

<div class="row">
    <div class="col-lg-3 mb-4">
        <div class="card shadow-sm border-0 sidebar-menu">
            <div class="card-body p-3">
                <h5 class="card-title mb-3"><i class="bi bi-shield-lock me-2 text-primary"></i>لوحة المدير</h5>
                <div class="list-group list-group-flush">
                    <a asp-controller="Admin" asp-action="Dashboard" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i>لوحة التحكم
                    </a>
                    <a asp-controller="Admin" asp-action="Users" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Users" ? "active" : "")">
                        <i class="bi bi-people me-2"></i>إدارة المستخدمين
                    </a>
                    <a asp-controller="Admin" asp-action="Employers" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Employers" ? "active" : "")">
                        <i class="bi bi-building me-2"></i>إدارة أصحاب العمل
                    </a>
                    <a asp-controller="Admin" asp-action="JobSeekers" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "JobSeekers" ? "active" : "")">
                        <i class="bi bi-person-badge me-2"></i>إدارة الباحثين
                    </a>
                    <a asp-controller="Account" asp-action="RegisterAdmin" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "RegisterAdmin" ? "active" : "")">
                        <i class="bi bi-person-plus me-2"></i>إضافة مدير
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-9">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}

@section Styles {
    @await RenderSectionAsync("Styles", required: false)
}
