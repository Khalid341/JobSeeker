@model ErrorViewModel
@{
    ViewData["Title"] = "خطأ في النظام";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 text-center">
        <div class="card shadow border-0">
            <div class="card-body p-5">
                <div class="mb-4">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size: 6rem; color: var(--danger-color);"></i>
                </div>
                <h2 class="text-danger mb-4">حدث خطأ غير متوقع</h2>
                <p class="text-muted mb-4" style="font-size: 1.2rem;">عذراً، حدث خطأ أثناء معالجة طلبك. يرجى المحاولة مرة أخرى لاحقاً.</p>

                @if (Model.ShowRequestId)
                {
                    <div class="alert alert-light border mb-4">
                        <p class="mb-0">
                            <strong class="text-dark">رقم الطلب:</strong> 
                            <code class="ms-2">@Model.RequestId</code>
                        </p>
                    </div>
                }

                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="bi bi-house-door me-2"></i>العودة للرئيسية
                </a>
            </div>
        </div>
    </div>
</div>
