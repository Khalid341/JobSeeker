@{
    Layout = "_Layout";
}

<div class="row">
    <div class="col-lg-3 mb-4">
        <div class="card shadow-sm border-0 sidebar-menu">
            <div class="card-body p-3">
                <h5 class="card-title mb-3"><i class="bi bi-person-circle me-2 text-primary"></i>لوحة الباحث</h5>
                <div class="list-group list-group-flush">
                    <a asp-controller="JobSeeker" asp-action="Dashboard" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i>لوحة التحكم
                    </a>
                    <a asp-controller="JobSeeker" asp-action="Profile" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Profile" ? "active" : "")">
                        <i class="bi bi-person me-2"></i>الملف الشخصي
                    </a>
                    <a asp-controller="JobSeeker" asp-action="EditProfile" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "EditProfile" ? "active" : "")">
                        <i class="bi bi-pencil-square me-2"></i>تعديل الملف
                    </a>
                    <a asp-controller="JobSeeker" asp-action="UploadResume" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "UploadResume" ? "active" : "")">
                        <i class="bi bi-file-earmark-pdf me-2"></i>رفع السيرة الذاتية
                    </a>
                    <a asp-controller="Notification" asp-action="Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Notification" ? "active" : "")">
                        <i class="bi bi-bell me-2"></i>الإشعارات
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-9">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}

@section Styles {
    @await RenderSectionAsync("Styles", required: false)
}
