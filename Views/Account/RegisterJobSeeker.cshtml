@model RegisterJobSeekerViewModel
@using JobSeeker.Constants
@{
    ViewData["Title"] = "تسجيل باحث عن عمل";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-lg border-0">
            <div class="card-header auth-header text-white text-center py-4">
                <div class="mb-3">
                    <i class="bi bi-person-plus-fill" style="font-size: 4rem; opacity: 0.9;"></i>
                </div>
                <h3 class="mb-0 fw-bold">انضم كباحث عن عمل</h3>
                <p class="mb-0 mt-2" style="opacity: 0.9;">أنشئ ملفك الشخصي وابدأ رحلتك المهنية</p>
            </div>
            <div class="card-body p-5">
                <form asp-controller="Account" asp-action="RegisterJobSeeker" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                    <div class="mb-4">
                        <label asp-for="FullName" class="form-label">
                            <i class="bi bi-person me-2"></i>الاسم الكامل
                        </label>
                        <input asp-for="FullName" class="form-control form-control-lg" placeholder="أدخل اسمك الكامل" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="Email" class="form-label">
                                <i class="bi bi-envelope me-2"></i>البريد الإلكتروني
                            </label>
                            <input asp-for="Email" class="form-control" placeholder="example@email.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="PhoneNumber" class="form-label">
                                <i class="bi bi-telephone me-2"></i>رقم الهاتف
                            </label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="05xxxxxxxx" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="Password" class="form-label">
                                <i class="bi bi-lock me-2"></i>كلمة المرور
                            </label>
                            <input asp-for="Password" class="form-control" placeholder="********" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">
                                <i class="bi bi-lock-fill me-2"></i>تأكيد كلمة المرور
                            </label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="********" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="Specialty" class="form-label">
                                <i class="bi bi-briefcase me-2"></i>التخصص
                            </label>
                            <select asp-for="Specialty" class="form-select" asp-items="SpecialtiesList.AsSelectListItems(Model.Specialty)">
                                <option value="">اختر التخصص</option>
                            </select>
                            <span asp-validation-for="Specialty" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="JobTitle" class="form-label">
                                <i class="bi bi-person-badge me-2"></i>المسمى الوظيفي
                            </label>
                            <input asp-for="JobTitle" class="form-control" placeholder="مثال: مطور Full Stack" />
                            <span asp-validation-for="JobTitle" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="City" class="form-label">
                            <i class="bi bi-geo-alt me-2"></i>المدينة
                        </label>
                        <input asp-for="City" class="form-control" placeholder="أدخل مدينتك" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-person-plus me-2"></i>إنشاء الحساب
                        </button>
                    </div>
                </form>

                <div class="text-center">
                    <p class="text-muted mb-0">لديك حساب بالفعل؟ <a asp-action="Login" class="fw-bold">تسجيل الدخول</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
