@model ChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0">
            <div class="card-header auth-header text-white text-center py-4">
                <div class="mb-3">
                    <i class="bi bi-shield-lock" style="font-size: 4rem; opacity: 0.9;"></i>
                </div>
                <h3 class="mb-0 fw-bold">تغيير كلمة المرور</h3>
                <p class="mb-0 mt-2" style="opacity: 0.9;">قم بتحديث كلمة المرور الخاصة بك</p>
            </div>
            <div class="card-body p-5">
                <form asp-controller="Account" asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                    <div class="mb-4">
                        <label asp-for="CurrentPassword" class="form-label">
                            <i class="bi bi-lock me-2"></i>كلمة المرور الحالية
                        </label>
                        <input asp-for="CurrentPassword" class="form-control form-control-lg" placeholder="********" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="NewPassword" class="form-label">
                            <i class="bi bi-key me-2"></i>كلمة المرور الجديدة
                        </label>
                        <input asp-for="NewPassword" class="form-control form-control-lg" placeholder="********" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">
                            <i class="bi bi-key-fill me-2"></i>تأكيد كلمة المرور الجديدة
                        </label>
                        <input asp-for="ConfirmPassword" class="form-control form-control-lg" placeholder="********" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-check-lg me-2"></i>حفظ التغييرات
                        </button>
                    </div>
                </form>

                <div class="text-center">
                    <a href="javascript:history.back()" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-right me-2"></i>رجوع
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
