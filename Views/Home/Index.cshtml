@{
    ViewData["Title"] = "الرئيسية";
    var stats = ViewBag.Stats;
}

<!-- Hero Section -->
<section class="hero-section mb-4">
    <div class="container position-relative">
        <div class="row align-items-center justify-content-center">
            <div class="col-lg-7 text-center text-lg-end">
                <h1 class="fw-bold">ابحث عن مواهب، أو وجد فرصتك</h1>
                <p class="lead">منصة LinkMe تربط أصحاب العمل بالباحثين عن عمل بسهولة.</p>
                <div class="d-flex justify-content-center justify-content-lg-start gap-2 flex-wrap">
                    <a asp-controller="Account" asp-action="RegisterEmployer" class="btn btn-light fw-bold">
                        <i class="bi bi-building me-2"></i>أنا صاحب عمل
                    </a>
                    <a asp-controller="Account" asp-action="RegisterJobSeeker" class="btn btn-outline-light fw-bold">
                        <i class="bi bi-person me-2"></i>أنا باحث عن عمل
                    </a>
                </div>
            </div>
            <div class="col-lg-5 text-center mt-3 mt-lg-0 d-none d-lg-block">
                <img src="~/images/hero-illustration.svg" alt="LinkMe" class="hero-illustration" />
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="mb-5">
    <div class="row g-4 text-center">
        <div class="col-6 col-md-3">
            <div class="card stats-card h-100">
                <div class="card-body">
                    <i class="bi bi-building-fill text-success mb-3"></i>
                    <h3 class="fw-bold text-dark">@stats.EmployersCount</h3>
                    <p class="text-muted mb-0">شركة مشاركة</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stats-card h-100">
                <div class="card-body">
                    <i class="bi bi-people-fill text-info mb-3"></i>
                    <h3 class="fw-bold text-dark">@stats.JobSeekersCount</h3>
                    <p class="text-muted mb-0">باحث عن عمل</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stats-card h-100">
                <div class="card-body">
                    <i class="bi bi-file-earmark-pdf-fill text-danger mb-3"></i>
                    <h3 class="fw-bold text-dark">@stats.ResumesCount</h3>
                    <p class="text-muted mb-0">سيرة ذاتية</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stats-card h-100">
                <div class="card-body">
                    <i class="bi bi-eye-fill text-warning mb-3"></i>
                    <h3 class="fw-bold text-dark">@stats.ProfileViewsCount</h3>
                    <p class="text-muted mb-0">مشاهدة ملف</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="mb-4">
    <div class="text-center mb-4">
        <h2 class="fw-bold mb-2 h4">كيف تعمل المنصة؟</h2>
        <p class="text-muted small mb-0">خطوات بسيطة تربطك بالفرصة المناسبة</p>
    </div>
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100 border-0 text-center p-3 shadow-sm">
                <div class="card-body">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                         style="width: 70px; height: 70px; background: linear-gradient(135deg, rgba(252, 163, 17, 0.1) 0%, rgba(224, 140, 10, 0.15) 100%);">
                        <i class="bi bi-person-plus-fill" style="font-size: 2rem; color: var(--orange);"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">أنشئ ملفك</h5>
                    <p class="text-muted mb-0 small" style="line-height: 1.7;">سجّل كباحث عن عمل وأنشئ ملفك الشخصي مع سيرتك الذاتية.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 text-center p-3 shadow-sm">
                <div class="card-body">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                         style="width: 70px; height: 70px; background: linear-gradient(135deg, rgba(20, 33, 61, 0.1) 0%, rgba(30, 49, 96, 0.15) 100%);">
                        <i class="bi bi-search-heart-fill" style="font-size: 2rem; color: var(--prussian-blue);"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">ابحث عن المواهب</h5>
                    <p class="text-muted mb-0 small" style="line-height: 1.7;">سجّل كصاحب عمل وابحث عن المرشحين حسب التخصص والمهارات.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 text-center p-3 shadow-sm">
                <div class="card-body">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                         style="width: 70px; height: 70px; background: linear-gradient(135deg, rgba(72, 187, 120, 0.1) 0%, rgba(56, 161, 105, 0.15) 100%);">
                        <i class="bi bi-bell-fill" style="font-size: 2rem; color: var(--success-color);"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">تلقّ الإشعارات</h5>
                    <p class="text-muted mb-0 small" style="line-height: 1.7;">احصل على إشعار فوري عندما يزور صاحب عمل ملفك الشخصي.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="card border-0 overflow-hidden">
    <div class="card-body p-4 text-center" style="background: linear-gradient(135deg, var(--prussian-blue) 0%, var(--prussian-blue-light) 100%); border-radius: var(--border-radius-lg);">
        <h3 class="fw-bold mb-2" style="color: var(--white); font-size: 1.4rem;">ابدأ رحلتك المهنية اليوم</h3>
        <p class="mb-3" style="color: rgba(255,255,255,0.9); font-size: 1rem;">انضم إلى مجتمع LinkMe واكتشف فرصاً لا حصر لها</p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <a asp-controller="Account" asp-action="RegisterEmployer" class="btn btn-light fw-bold">
                <i class="bi bi-briefcase me-2"></i>توظف الآن
            </a>
            <a asp-controller="Account" asp-action="RegisterJobSeeker" class="btn btn-outline-light fw-bold">
                <i class="bi bi-person-badge me-2"></i>أنشئ ملفك
            </a>
        </div>
    </div>
</section>
