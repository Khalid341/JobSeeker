@model ErrorViewModel
@{
    ViewData["Title"] = "خطأ في النظام";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 text-center">
        <div class="card shadow border-0">
            <div class="card-body p-5">
                <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 6rem;"></i>
                <h1 class="display-1 fw-bold text-danger mb-3">500</h1>
                <h2 class="text-dark mb-4">حدث خطأ غير متوقع</h2>
                <p class="text-muted mb-5" style="font-size: 1.1rem;">
                    عذراً، حدث خطأ أثناء معالجة طلبك. تم تسجيل الخطأ وسيتم مراجعته من قبل الفريق الفني.
                </p>
                @if (Model.ShowRequestId)
                {
                    <p class="text-muted small mb-4">
                        <strong>رقم الطلب:</strong> <code>@Model.RequestId</code>
                    </p>
                }
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="bi bi-house-door me-2"></i>العودة للرئيسية
                </a>
            </div>
        </div>
    </div>
</div>
