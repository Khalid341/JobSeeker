@{
    ViewData["Title"] = "سياسة الخصوصية";
}

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-white border-bottom py-4">
        <div class="d-flex align-items-center">
            <i class="bi bi-shield-check-fill me-3" style="font-size: 2.5rem; color: var(--success-color);"></i>
            <div>
                <h3 class="mb-0 text-dark">@ViewData["Title"]</h3>
                <p class="text-muted mb-0 mt-1">كيف نحمي بياناتك الشخصية</p>
            </div>
        </div>
    </div>
    <div class="card-body p-5">
        <div class="row">
            <div class="col-md-8">
                <h5 class="text-dark mb-3">التزامنا بخصوصيتك</h5>
                <p class="text-muted" style="line-height: 2; font-size: 1.1rem;">
                    نحن نحترم خصوصيتك ونلتزم بحماية بياناتك الشخصية. يتم استخدام المعلومات التي تقدمها فقط لأغراض استخدام المنصة وربطك بالمرشحين أو أصحاب العمل المناسبين.
                </p>
                
                <h5 class="text-dark mb-3 mt-5">مشاركة البيانات</h5>
                <p class="text-muted" style="line-height: 2; font-size: 1.1rem;">
                    لا نقوم بمشاركة بياناتك مع أي طرف ثالث دون موافقتك الصريحة. نحن نستخدم أحدث تقنيات التشفير لحماية معلوماتك.
                </p>

                <h5 class="text-dark mb-3 mt-5">حقوقك</h5>
                <ul class="text-muted" style="line-height: 2.2; font-size: 1.1rem;">
                    <li>الحق في الوصول إلى بياناتك الشخصية</li>
                    <li>الحق في تصحيح أو تحديث معلوماتك</li>
                    <li>الحق في حذف حسابك وبياناتك</li>
                    <li>الحق في الاعتراض على معالجة بياناتك</li>
                </ul>
            </div>
            <div class="col-md-4">
                <div class="card border-0" style="background: linear-gradient(135deg, rgba(72, 187, 120, 0.1) 0%, rgba(56, 161, 105, 0.15) 100%);">
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-lock-fill mb-3" style="font-size: 4rem; color: var(--success-color);"></i>
                        <h6 class="text-dark mb-2">بياناتك آمنة</h6>
                        <p class="text-muted small mb-0">نستخدم تشفير SSL لحماية جميع البيانات المنقولة</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
