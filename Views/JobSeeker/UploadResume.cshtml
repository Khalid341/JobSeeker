@model UploadResumeViewModel
@{
    ViewData["Title"] = "رفع السيرة الذاتية";
    Layout = "_JobSeekerLayout";
    var hasResume = ViewBag.HasResume as bool? ?? false;
    var resumeOriginalName = ViewBag.ResumeOriginalName as string;
    var resumeUploadedAt = ViewBag.ResumeUploadedAt as DateTime?;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-white border-bottom py-4">
                <h4 class="mb-0">
                    <i class="bi bi-file-earmark-pdf-fill me-2 text-danger"></i>رفع السيرة الذاتية
                </h4>
            </div>
            <div class="card-body p-5">
                <div class="alert alert-info mb-4">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    يجب أن يكون الملف بصيغة PDF فقط، والحد الأقصى للحجم 5 ميجابايت.
                </div>

                @if (hasResume)
                {
                    <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, rgba(72, 187, 120, 0.1) 0%, rgba(56, 161, 105, 0.15) 100%);">
                        <div class="card-body p-4">
                            <h6 class="fw-bold mb-3">
                                <i class="bi bi-check-circle-fill me-2 text-success"></i>السيرة الذاتية الحالية
                            </h6>
                            <div class="mb-3">
                                <label class="fw-bold text-dark mb-1">اسم الملف:</label>
                                <p class="text-muted mb-0">
                                    <i class="bi bi-file-earmark-pdf-fill me-2 text-danger"></i>@resumeOriginalName
                                </p>
                            </div>
                            <div class="mb-3">
                                <label class="fw-bold text-dark mb-1">تاريخ الرفع:</label>
                                <p class="text-muted mb-0">
                                    <i class="bi bi-calendar me-2"></i>@resumeUploadedAt?.ToString("yyyy-MM-dd HH:mm")
                                </p>
                            </div>
                            <form asp-action="DeleteResume" method="post" class="mt-3" onsubmit="return confirm('هل أنت متأكد من حذف السيرة الذاتية؟');">
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="bi bi-trash me-2"></i>حذف السيرة الذاتية
                                </button>
                            </form>
                        </div>
                    </div>
                }

                <form asp-action="UploadResume" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                    <div class="mb-4">
                        <label asp-for="ResumeFile" class="form-label">
                            <i class="bi bi-cloud-upload me-2"></i>اختر ملف السيرة الذاتية
                        </label>
                        <input asp-for="ResumeFile" type="file" class="form-control form-control-lg" accept=".pdf" />
                        <span asp-validation-for="ResumeFile" class="text-danger small"></span>
                        <small class="form-text text-muted mt-2">
                            <i class="bi bi-info-circle me-1"></i>الصيغ المقبولة: PDF فقط
                        </small>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-cloud-upload-fill me-2"></i>@(hasResume ? "استبدال السيرة الذاتية" : "رفع السيرة الذاتية")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
